* text=auto
*.png binary
*.ico binary
*.icns binary
*.car binary
*.jar binary
*.woff binary
*.woff2 binary
*.exe binary

# Windows toplu is dosyalari her zaman CRLF olmali
*.bat text eol=crlf

# Wails writes the bindings and gofmt writes Go files with LF; with autocrlf the
# working copy would otherwise flip to CRLF and every regeneration would show
# the files as changed.
frontend/bindings/** text eol=lf
*.go text eol=lf
*.webp binary
*.jpg binary
