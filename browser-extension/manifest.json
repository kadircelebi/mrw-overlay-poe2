{
  "manifest_version": 3,
  "name": "MrW Overlay for POE 2 Bridge",
  "version": "1.2.0",
  "description": "Connects your pathofexile.com session and account name to MrW Overlay on this computer, only when the app asks.",
  "homepage_url": "https://poe2.mrwproject.com/extension/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "MrW Overlay"
  },
  "key": "",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://www.pathofexile.com/*",
    "http://127.0.0.1:47819/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pathofexile.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "poe2-bridge@mrw-poe2-filter",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
