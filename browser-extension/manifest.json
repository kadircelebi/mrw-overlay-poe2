{
  "manifest_version": 3,
  "name": "MrW POE2 Filter - pathofexile.com bridge",
  "version": "1.0.1",
  "description": "Hands your pathofexile.com session to the MrW POE2 Filter app on this computer, only when the app asks for it.",
  "key": "",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://www.pathofexile.com/*",
    "http://127.0.0.1:47819/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pathofexile.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "poe2-bridge@mrw-poe2-filter",
      "strict_min_version": "128.0"
    }
  }
}
