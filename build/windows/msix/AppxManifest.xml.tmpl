<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package manifest. Rendered by cmd/storepack from
     build/windows/msix/identity.json and the app version; do not edit the
     generated copy. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap uap5 rescap virtualization">

  <Identity
    Name="{{.IdentityName}}"
    Publisher="{{.Publisher}}"
    Version="{{.Version}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{.DisplayName}}</DisplayName>
    <PublisherDisplayName>{{.PublisherDisplayName}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Only the app's own folder %APPDATA%\PoE2Filtre is left unvirtualized
         (Windows 11 flexible virtualization; the Store refused the global
         desktop6 switch). The browser loads the unpacked extension from
         there, and the GitHub build shares the same settings. Everything
         else in AppData stays virtualized. The app never writes to the
         registry, so no registry exclusion. The loot filter goes to
         Documents\My Games\Path of Exile 2, which is not virtualized. -->
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:RoamingAppData)\PoE2Filtre</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="poe2filter.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{.DisplayName}}"
        Description="{{.Description}}"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="MrW Overlay" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#101215" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="poe2filter.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="MrWOverlayStartup" Enabled="false" DisplayName="{{.DisplayName}}" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
